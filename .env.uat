# UAT overrides - loaded on top of .env with `vite --mode uat` / `vite build --mode uat`.
# Only the values that differ from dev are listed; request-method names etc. come from .env.

VITE_MQTT_PASSWORD=password1

VITE_MQTT_USERNAME=user1

# Base URL
VITE_API_BASE_URL=https://pad.letsdiskus.com/

# Endpoints (BASE_URL + endpoint, e.g. https://pad.letsdiskus.com/PADAuth/)
VITE_API_AUTH=PADAuth/
VITE_API_TRADE=PADTrade/
VITE_API_ADMIN=PADAdmin/
VITE_API_REPORT=PADReports/
VITE_API_SETTINGS=PADSettings/
